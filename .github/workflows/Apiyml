name: FoxMail API

# API workflow for FoxMail (snjackson044-droid/FoxMail).
# Validates the FoxMail API contract on every push / PR to main that
# touches the server, the typed client, the database, or this workflow.
#
# FoxMail's server is server/src/actions.ts (Hatch space actions).
# The client calls it with POST ./actions { action, args } via
# client/src/api.ts (createActionClient). See docs/API.md.
#
# NOTE on the build job: package.json depends on @hatch/space-sdk via a
# local file: path (/opt/hatch/skills/spaces/ts-runtime/dist/space-sdk.tgz).
# That file is not in this repo and is not on a public GitHub runner, so
# `bun install` / typecheck / build cannot succeed there yet. The build
# job is therefore continue-on-error: it reports its status without
# blocking the API-contract job. Once the SDK is published or vendored,
# remove `continue-on-error` from the build job.

on:
  push:
    branches: [main]
    paths:
      - "server/**"
      - "client/src/api.ts"
      - "client/src/App.tsx"
      - "drizzle/**"
      - "package.json"
      - "bun.lock"
      - "scripts/api-workflow-check.mjs"
      - ".github/workflows/api.yml"
  pull_request:
    branches: [main]
    paths:
      - "server/**"
      - "client/src/api.ts"
      - "client/src/App.tsx"
      - "drizzle/**"
      - "package.json"
      - "bun.lock"
      - "scripts/api-workflow-check.mjs"
      - ".github/workflows/api.yml"

permissions:
  contents: read

jobs:
  api-contract:
    name: API contract
    runs-on: ubuntu-latest
    steps:
      - name: Check out
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Check FoxMail API contract
        run: node scripts/api-workflow-check.mjs

  build:
    name: Typecheck and build (Hatch SDK required)
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - name: Check out
        uses: actions/checkout@v4

      - name: Set up Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.3.10"

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Typecheck client and server
        run: bun run typecheck

      - name: Build server and client
        run: bun run build
